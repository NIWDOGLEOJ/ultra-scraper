{
  "name": "ultra-scraper",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "scrape": "tsx src/index.ts",
    "app:later": "tsx src/app.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup:browser": "playwright install chromium",
    "setup:browser:linux": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
